# Password that gates /admin (RSVP list). Set the real value in Vercel's
# project environment variables (or a local .env.local, which is gitignored)
# — never commit the actual password.
ADMIN_PASSWORD=change-me

# RSVP storage. Added automatically when an Upstash Redis database is
# connected from the Vercel project's Storage tab. Leave unset locally to use
# the .data/rsvps.json file instead.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
